<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:actionBarStyle">@style/AppActionBar</item>
        <item name="android:windowBackground">@color/list_bg</item>
    </style>

    <style name="AppActionBar" parent="android:Widget.Material.ActionBar.Solid">
        <item name="android:background">@color/primary</item>
        <item name="android:titleTextStyle">@style/AppActionBarTitle</item>
    </style>

    <style name="AppActionBarTitle" parent="android:TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">@color/yellow</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Žuto dugme sa plavim tekstom -->
    <style name="YellowButton" parent="android:Widget.Material.Button">
        <item name="android:backgroundTint">@color/yellow</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="SmallYellowButton" parent="YellowButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Dugmad u donjoj traci -->
    <style name="BarButton" parent="YellowButton">
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Broj u žutoj traci pregleda -->
    <style name="StatTile">
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

    <!-- Red forme u prozoru artikla: naziv levo, polje desno -->
    <style name="FormRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="FormLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="FormField">
        <item name="android:layout_width">110dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:selectAllOnFocus">true</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>
