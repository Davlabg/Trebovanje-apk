<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Rezultat: uvek na vrhu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_yellow"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_needed"
                    android:textColor="@color/navy"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/needed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/col_order"
                    android:textColor="@color/navy"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/to_order"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/needed_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Trenutno stanje -->
        <LinearLayout style="@style/FormRow">
            <TextView
                style="@style/FormLabel"
                android:text="@string/label_stock" />
            <EditText
                android:id="@+id/stock"
                style="@style/FormField"
                android:hint="—"
                android:importantForAutofill="no"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <!-- Korekcija % -->
        <LinearLayout style="@style/FormRow">
            <TextView
                style="@style/FormLabel"
                android:text="@string/label_percent" />
            <Button
                android:id="@+id/pct_minus"
                style="@style/SmallYellowButton"
                android:text="−10" />
            <EditText
                android:id="@+id/pct"
                style="@style/FormField"
                android:layout_width="64dp"
                android:hint="0"
                android:importantForAutofill="no"
                android:inputType="numberSigned|numberDecimal" />
            <Button
                android:id="@+id/pct_plus"
                style="@style/SmallYellowButton"
                android:text="+10" />
        </LinearLayout>

        <!-- Safety stock -->
        <LinearLayout style="@style/FormRow">
            <TextView
                android:id="@+id/safety_label"
                style="@style/FormLabel" />
            <EditText
                android:id="@+id/safety"
                style="@style/FormField"
                android:hint="0"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <!-- Magacin -->
        <LinearLayout
            android:id="@+id/warehouse_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_light"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/warehouse"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp" />

            <Button
                android:id="@+id/link"
                style="@style/SmallYellowButton"
                android:layout_marginStart="8dp"
                android:text="@string/link_short" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
