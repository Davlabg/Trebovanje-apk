<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Rezultat: uvek na vrhu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_yellow"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_needed"
                    android:textColor="@color/navy"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/needed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/needed_tp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/navy"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/col_order"
                    android:textColor="@color/navy"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/to_order"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/to_order_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/navy"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/needed_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Popis u TP ili u jedinici iz izveštaja -->
        <LinearLayout
            android:id="@+id/mode_row"
            style="@style/FormRow">
            <TextView
                style="@style/FormLabel"
                android:text="@string/label_count_in" />
            <Button
                android:id="@+id/mode_tp"
                style="@style/SmallYellowButton"
                android:text="@string/tp" />
            <Button
                android:id="@+id/mode_unit"
                style="@style/SmallYellowButton"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Trenutno stanje (može i račun: 3*15+4) -->
        <LinearLayout style="@style/FormRow">
            <TextView
                android:id="@+id/stock_label"
                style="@style/FormLabel"
                android:text="@string/label_stock" />
            <EditText
                android:id="@+id/stock"
                style="@style/FormField"
                android:layout_width="150dp"
                android:hint="—"
                android:importantForAutofill="no"
                android:imeOptions="actionNext"
                android:inputType="phone" />
        </LinearLayout>

        <TextView
            android:id="@+id/stock_calc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Mini kalkulator -->
        <LinearLayout
            android:id="@+id/calc_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <Button android:id="@+id/calc_plus" style="@style/CalcButton" android:text="+" />
            <Button android:id="@+id/calc_minus" style="@style/CalcButton" android:text="−" />
            <Button android:id="@+id/calc_times" style="@style/CalcButton" android:text="×" />
            <Button android:id="@+id/calc_div" style="@style/CalcButton" android:text="÷" />
            <Button android:id="@+id/calc_open" style="@style/CalcButton" android:text="(" />
            <Button android:id="@+id/calc_close" style="@style/CalcButton" android:text=")" />
            <Button android:id="@+id/calc_eq" style="@style/CalcButton" android:text="=" />
            <Button android:id="@+id/calc_back" style="@style/CalcButton" android:text="⌫" />
        </LinearLayout>

        <!-- Korekcija % -->
        <LinearLayout style="@style/FormRow">
            <TextView
                style="@style/FormLabel"
                android:text="@string/label_percent" />
            <Button
                android:id="@+id/pct_minus"
                style="@style/SmallYellowButton"
                android:text="−10" />
            <EditText
                android:id="@+id/pct"
                style="@style/FormField"
                android:layout_width="64dp"
                android:hint="0"
                android:importantForAutofill="no"
                android:inputType="numberSigned|numberDecimal" />
            <Button
                android:id="@+id/pct_plus"
                style="@style/SmallYellowButton"
                android:text="+10" />
        </LinearLayout>

        <!-- Safety stock -->
        <LinearLayout style="@style/FormRow">
            <TextView
                android:id="@+id/safety_label"
                style="@style/FormLabel" />
            <EditText
                android:id="@+id/safety"
                style="@style/FormField"
                android:hint="0"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <!-- Količina u TP -->
        <LinearLayout style="@style/FormRow">
            <TextView
                android:id="@+id/tp_label"
                style="@style/FormLabel" />
            <EditText
                android:id="@+id/tp_qty"
                style="@style/FormField"
                android:hint="—"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tp_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Magacin -->
        <LinearLayout
            android:id="@+id/warehouse_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_light"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:id="@+id/warehouse"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp" />

            <Button
                android:id="@+id/link"
                style="@style/SmallYellowButton"
                android:layout_marginStart="8dp"
                android:text="@string/link_short" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
